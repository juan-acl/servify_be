// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

// ══════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ProfessionalLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum UrgencyLevel {
  EMERGENCY
  TODAY
  SCHEDULED
}

enum RequestStatus {
  PENDING
  ACTIVE
  ACCEPTED
  IN_TRANSIT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MessageType {
  TEXT
  SYSTEM
}

// ══════════════════════════════════════════
// TABLAS
// ══════════════════════════════════════════

model User {
  id         String   @id @default(uuid())
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String   @unique
  password   String   @map("password")
  phone      String
  role       String   @default("CLIENT") // UserRole
  avatarUrl  String?  @map("avatar_url")
  isVerified Boolean  @default(false) @map("is_verified")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relaciones
  professionalProfile         ProfessionalProfile?
  requestsAsClient            ServiceRequest[]     @relation("ClientRequests")
  offersAsProfessional        Offer[]              @relation("ProfessionalOffers")
  executionsAsProfessional    ServiceExecution[]   @relation("ProfessionalExecutions")
  conversationsAsClient       Conversation[]       @relation("ClientConversations")
  conversationsAsProfessional Conversation[]       @relation("ProfessionalConversations")
  messagesSent                Message[]            @relation("SenderMessages")
  reviewsGiven                Review[]             @relation("ReviewerReviews")
  reviewsReceived             Review[]             @relation("ReviewedReviews")
  notifications               Notification[]

  @@map("users")
}

model ProfessionalProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  dpiNumber         String   @unique @map("dpi_number")
  bio               String?
  radiusKm          Int      @default(10) @map("radius_km")
  isAvailable       Boolean  @default(false) @map("is_available")
  isVerifiedByAdmin Boolean  @default(false) @map("is_verified_by_admin")
  level             String   @default("BRONZE") // ProfessionalLevel
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relaciones
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("professional_profiles")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  icon        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relaciones
  requests ServiceRequest[]

  @@map("categories")
}

model ServiceRequest {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  categoryId  String    @map("category_id")
  description String
  urgency     String // UrgencyLevel
  status      String    @default("PENDING") // RequestStatus
  address     String
  latitude    Float
  longitude   Float
  scheduledAt DateTime? @map("scheduled_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relaciones
  client       User              @relation("ClientRequests", fields: [clientId], references: [id])
  category     Category          @relation(fields: [categoryId], references: [id])
  offers       Offer[]
  execution    ServiceExecution?
  conversation Conversation?
  reviews      Review[]

  @@map("service_requests")
}

model Offer {
  id                      String   @id @default(uuid())
  requestId               String   @map("request_id")
  professionalId          String   @map("professional_id")
  price                   Float
  estimatedArrivalMinutes Int      @map("estimated_arrival_minutes")
  comment                 String?
  status                  String   @default("PENDING") // OfferStatus
  createdAt               DateTime @default(now()) @map("created_at")

  // Relaciones
  request      ServiceRequest    @relation(fields: [requestId], references: [id])
  professional User              @relation("ProfessionalOffers", fields: [professionalId], references: [id])
  execution    ServiceExecution?

  @@unique([requestId, professionalId])
  @@map("offers")
}

model ServiceExecution {
  id             String    @id @default(uuid())
  requestId      String    @unique @map("request_id")
  professionalId String    @map("professional_id")
  offerId        String    @unique @map("offer_id")
  startedAt      DateTime? @map("started_at")
  arrivedAt      DateTime? @map("arrived_at")
  completedAt    DateTime? @map("completed_at")
  notes          String?
  originalPrice  Float     @map("original_price")
  finalPrice     Float     @map("final_price")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relaciones
  request      ServiceRequest @relation(fields: [requestId], references: [id])
  professional User           @relation("ProfessionalExecutions", fields: [professionalId], references: [id])
  offer        Offer          @relation(fields: [offerId], references: [id])

  @@map("service_executions")
}

model Conversation {
  id             String   @id @default(uuid())
  requestId      String   @unique @map("request_id")
  clientId       String   @map("client_id")
  professionalId String   @map("professional_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relaciones
  request      ServiceRequest @relation(fields: [requestId], references: [id])
  client       User           @relation("ClientConversations", fields: [clientId], references: [id])
  professional User           @relation("ProfessionalConversations", fields: [professionalId], references: [id])
  messages     Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String
  type           String   @default("TEXT") // MessageType
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relaciones
  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("SenderMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Review {
  id         String   @id @default(uuid())
  requestId  String   @map("request_id")
  reviewerId String   @map("reviewer_id")
  reviewedId String   @map("reviewed_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relaciones
  request  ServiceRequest @relation(fields: [requestId], references: [id])
  reviewer User           @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  reviewed User           @relation("ReviewedReviews", fields: [reviewedId], references: [id])

  @@unique([requestId, reviewerId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String
  data      String? // JSON como string, parsear en el código
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
